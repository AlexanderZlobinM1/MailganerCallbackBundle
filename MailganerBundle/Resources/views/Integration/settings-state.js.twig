(function () {
    'use strict';
    var footer = document.querySelector('[data-mailganer-settings-footer]');
    var form = footer && footer.closest('form');
    var settings = form && form.querySelector('#integration_details_apiKeys');
    if (!settings) return;

    function updateState() {
        var selected = form.querySelector('[name="integration_details[isPublished]"]:checked');
        var enabled = selected && selected.value === '1';
        // Keep successful form controls submitted so disabling never clears saved options.
        // inert blocks both mouse and keyboard editing without dropping form values.
        settings.inert = !enabled;
        settings.setAttribute('aria-disabled', enabled ? 'false' : 'true');
        settings.style.opacity = enabled ? '' : '0.45';
        settings.style.filter = enabled ? '' : 'grayscale(1)';
        settings.style.pointerEvents = enabled ? '' : 'none';
    }

    mQuery(form).off('change.mailganerState', '[name="integration_details[isPublished]"]')
        .on('change.mailganerState', '[name="integration_details[isPublished]"]', updateState);
    updateState();
}());
